<?xml version="1.0" encoding="UTF-8"?>
<project name="module_compacttoexploded" default="compile.module.compacttoexploded">
  <dirname property="module.compacttoexploded.basedir" file="${ant.file.module_compacttoexploded}"/>
  
  <property name="module.jdk.home.compacttoexploded" value="${project.jdk.home}"/>
  <property name="module.jdk.bin.compacttoexploded" value="${project.jdk.bin}"/>
  <property name="module.jdk.classpath.compacttoexploded" value="${project.jdk.classpath}"/>
  
  <property name="compiler.args.compacttoexploded" value="-encoding UTF-8 -source 8 -target 8 ${compiler.args}"/>
  
  <property name="compacttoexploded.output.dir" value="${module.compacttoexploded.basedir}/target/classes"/>
  <property name="compacttoexploded.testoutput.dir" value="${module.compacttoexploded.basedir}/target/test-classes"/>
  
  <path id="compacttoexploded.module.bootclasspath">
    <!-- Paths to be included in compilation bootclasspath -->
  </path>
  
  <path id="compacttoexploded.module.production.classpath">
    <path refid="${module.jdk.classpath.compacttoexploded}"/>
  </path>
  
  <path id="compacttoexploded.runtime.production.module.classpath">
    <pathelement location="${compacttoexploded.output.dir}"/>
  </path>
  
  <path id="compacttoexploded.module.classpath">
    <path refid="${module.jdk.classpath.compacttoexploded}"/>
    <pathelement location="${compacttoexploded.output.dir}"/>
  </path>
  
  <path id="compacttoexploded.runtime.module.classpath">
    <pathelement location="${compacttoexploded.testoutput.dir}"/>
    <pathelement location="${compacttoexploded.output.dir}"/>
  </path>
  
  
  <patternset id="excluded.from.module.compacttoexploded">
    <patternset refid="ignored.files"/>
  </patternset>
  
  <patternset id="excluded.from.compilation.compacttoexploded">
    <patternset refid="excluded.from.module.compacttoexploded"/>
  </patternset>
  
  <path id="compacttoexploded.module.sourcepath">
    <dirset dir="${module.compacttoexploded.basedir}">
      <include name="src/main/java"/>
      <include name="src/main/resources"/>
    </dirset>
  </path>
  
  <path id="compacttoexploded.module.test.sourcepath">
    <dirset dir="${module.compacttoexploded.basedir}">
      <include name="src/test/java"/>
    </dirset>
  </path>
  
  
  <target name="compile.module.compacttoexploded" depends="compile.module.compacttoexploded.production,compile.module.compacttoexploded.tests" description="Compile module CompactToExploded"/>
  
  <target name="compile.module.compacttoexploded.production" depends="register.custom.compilers" description="Compile module CompactToExploded; production classes">
    <mkdir dir="${compacttoexploded.output.dir}"/>
    <javac2 destdir="${compacttoexploded.output.dir}" debug="${compiler.debug}" nowarn="${compiler.generate.no.warnings}" memorymaximumsize="${compiler.max.memory}" fork="true" executable="${module.jdk.bin.compacttoexploded}/javac">
      <compilerarg line="${compiler.args.compacttoexploded}"/>
      <bootclasspath refid="compacttoexploded.module.bootclasspath"/>
      <classpath refid="compacttoexploded.module.production.classpath"/>
      <src refid="compacttoexploded.module.sourcepath"/>
      <patternset refid="excluded.from.compilation.compacttoexploded"/>
    </javac2>
    
    <copy todir="${compacttoexploded.output.dir}">
      <fileset dir="${module.compacttoexploded.basedir}/src/main/java">
        <patternset refid="compiler.resources"/>
        <type type="file"/>
      </fileset>
      <fileset dir="${module.compacttoexploded.basedir}/src/main/resources">
        <patternset refid="compiler.resources"/>
        <type type="file"/>
      </fileset>
    </copy>
  </target>
  
  <target name="compile.module.compacttoexploded.tests" depends="register.custom.compilers,compile.module.compacttoexploded.production" description="compile module CompactToExploded; test classes" unless="skip.tests">
    <mkdir dir="${compacttoexploded.testoutput.dir}"/>
    <javac2 destdir="${compacttoexploded.testoutput.dir}" debug="${compiler.debug}" nowarn="${compiler.generate.no.warnings}" memorymaximumsize="${compiler.max.memory}" fork="true" executable="${module.jdk.bin.compacttoexploded}/javac">
      <compilerarg line="${compiler.args.compacttoexploded}"/>
      <bootclasspath refid="compacttoexploded.module.bootclasspath"/>
      <classpath refid="compacttoexploded.module.classpath"/>
      <src refid="compacttoexploded.module.test.sourcepath"/>
      <patternset refid="excluded.from.compilation.compacttoexploded"/>
    </javac2>
    
    <copy todir="${compacttoexploded.testoutput.dir}">
      <fileset dir="${module.compacttoexploded.basedir}/src/test/java">
        <patternset refid="compiler.resources"/>
        <type type="file"/>
      </fileset>
    </copy>
  </target>
  
  <target name="clean.module.compacttoexploded" description="cleanup module">
    <delete dir="${compacttoexploded.output.dir}"/>
    <delete dir="${compacttoexploded.testoutput.dir}"/>
  </target>
</project>